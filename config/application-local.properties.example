# Copy this file to config/application-local.properties, then replace every value.
# This file is safe to commit; application-local.properties is intentionally ignored.

# MySQL database for local development
ILLUSTRATION_ARCHIVE_DB_URL=jdbc:mysql://localhost:3306/illustration_archive?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
ILLUSTRATION_ARCHIVE_DB_USERNAME=replace_with_your_mysql_username
ILLUSTRATION_ARCHIVE_DB_PASSWORD=replace_with_your_mysql_password

# Use a writable directory outside this Git repository. An absolute path is allowed here.
ILLUSTRATION_ARCHIVE_STORAGE_ROOT=replace_with_your_local_storage_root

# Optional S3-compatible experiment. Omit these for normal Local Storage.
# ILLUSTRATION_ARCHIVE_STORAGE_TYPE=s3
# ILLUSTRATION_ARCHIVE_S3_ENDPOINT=http://localhost:4566
# ILLUSTRATION_ARCHIVE_S3_REGION=us-east-1
# ILLUSTRATION_ARCHIVE_S3_ACCESS_KEY=test
# ILLUSTRATION_ARCHIVE_S3_SECRET_KEY=test
# ILLUSTRATION_ARCHIVE_S3_BUCKET=illustration-archive
# ILLUSTRATION_ARCHIVE_S3_PATH_STYLE=true

# Optional X Likes inbox sync. Copy the separately ignored x-oauth-tokens.properties.example
# to x-oauth-tokens.properties and fill its initial tokens locally.
# Client Secret belongs only in the ignored local copy or an environment variable.
X_API_ENABLED=false
X_API_BASE_URL=https://api.x.com
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# X_OAUTH_CREDENTIAL_FILE=./config/x-oauth-tokens.properties
X_API_DEFAULT_PAGE_SIZE=5
X_API_DEFAULT_MAX_PAGES=3

# Optional manual Gemini analysis. Use a Free Tier project; never put a real key in this example.
AI_ANALYSIS_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
AI_ANALYSIS_TIMEOUT_SECONDS=90
